        "autoprefixer": "10.4.27",
        "brevo": "1.0.0",
        "clsx": "2.1.1",
        "csurf": "1.11.0",
        "helmet": "8.1.0",
        "jose": "6.1.3",
        "ladle": "0.0.0",
        "mastra": "0.18.9",
        "neverthrow": "8.2.0",
        "next": "16.3.5",
        "openai": "5.23.2",
        "pdf-parse": "1.1.4",
        "pino": "9.14.0",
        "postcss": "8.5.28",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "superjson": "2.2.6",
        "tailwindcss": "4.1.18",
        "zod": "4.6.5",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@cloudflare/next-on-pages": "1.13.16",
